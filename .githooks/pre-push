#!/bin/sh
# Refuse to push code that fails the syntax check, lint or tests.
# Enable once per clone:  git config core.hooksPath .githooks
# The test suite needs TEST_DATABASE_URL; without it only check + lint run.
set -e
npm run --silent check
npm run --silent lint
if [ -n "$TEST_DATABASE_URL" ]; then
  npm test
else
  echo "pre-push: TEST_DATABASE_URL is not set; tests skipped (CI still runs them)." >&2
fi
