KINDGLEAM_DEV_DB_PASSWORD=replace-with-a-local-development-password
# ---------------------------------------------------------------- required
# Runtime database identity. In production this must be DML-only.
DATABASE_URL=postgres://kindgleam_runtime:password@localhost:5432/kindgleam
# Privileged migration identity. In production this MUST be a different role.
DATABASE_MIGRATION_URL=postgres://kindgleam_migrate:password@localhost:5432/kindgleam
# Dedicated backup read identity. In production this MUST be different from runtime and migration identities.
BACKUP_DATABASE_URL=postgres://kindgleam_backup:password@localhost:5432/kindgleam
# Dedicated restore identity. In production this MUST be different from runtime, migration and backup identities.
RESTORE_DATABASE_URL=postgres://kindgleam_restore:password@localhost:5432/kindgleam

# ---------------------------------------------------------------- server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
# auto=hosted on the server; local/hybrid are used by desktop/local deployments.
RUNTIME_MODE=auto

# Set ONLY behind proxies you control; it decides which X-Forwarded-For entry
# is the client address the rate limiter keys on. true = one proxy (e.g. a
# load balancer); 2 = two layers (e.g. CDN + load balancer); or a list of
# proxy addresses/subnets such as 10.0.0.0/8. Every hop is never trusted.
TRUST_PROXY=false
# After SIGTERM, milliseconds to keep serving while /api/ready reports 503,
# so a load balancer stops routing here first (e.g. 5000 behind one that
# checks readiness every few seconds). 0 closes at once.
SHUTDOWN_DRAIN_MS=0
# Bearer token (32+ characters) monitoring uses to scrape /api/metrics. It is
# checked in memory, so metrics stay readable while the database is down.
METRICS_TOKEN=
# Session cookies over plain HTTP are readable on the network. Forced on in
# production; the server refuses to start if you turn it off there.
COOKIE_SECURE=false
# Base64 for a 32-byte secret. Required in production; never commit the real value.
# Encrypts opaque Stripe reference/event metadata only. Payment methods and
# billing-profile data live in Stripe and are never stored here.
BILLING_ENCRYPTION_KEY=
PERSONAL_DATA_ENCRYPTION_KEY=
# During key rotation, keep the immediately previous key here until the
# application has re-encrypted every record. Never reuse the current key.
BILLING_ENCRYPTION_KEY_PREVIOUS=
PERSONAL_DATA_ENCRYPTION_KEY_PREVIOUS=

OBJECT_ENCRYPTION_KEY=

# ---------------------------------------------------------------- database
# Your own PostgreSQL server (no managed cloud database is used).
# disable: same host or private network | require: encrypt, do not verify the
# certificate | verify: encrypt and verify against PGSSLROOTCERT (production default)
PGSSLMODE=disable
PGSSLROOTCERT=
# Postgres has a hard max_connections. Keep poolMax * instances below it.
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------- reasoning
# Google Vertex AI Gemini is the sole model family used by the adaptive runtime.
# In Google Cloud, Application Default Credentials / workload identity are used
# automatically. VERTEX_ACCESS_TOKEN is only for local smoke tests or temporary
# development and should not be committed.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_ACCESS_TOKEN=
VERTEX_MODEL=gemini-3.8-flash

# Adaptive reasoning effort: low, medium, high or xhigh (xhigh maps to HIGH).
AI_EFFORT=

# ---------------------------------------------------------------- MCP (optional shared tool infrastructure)
# JSON array of remote Model Context Protocol servers. Production endpoints
# must use HTTPS. Keep authentication headers in your secret manager/env, never
# in source control. Discovery is cached; calls are bounded by timeout,
# concurrency and circuit-breaker settings.
# MCP_SERVERS_JSON=[{"name":"github-tools","url":"https://mcp.example.com/mcp","headers":{"authorization":"Bearer ..."},"timeoutMs":15000,"cacheMs":60000,"maxConcurrency":4,"queueTimeoutMs":3000,"circuitFailures":3,"circuitOpenMs":30000}]

# ---------------------------------------------------------------- adaptive orchestration
# Specialist breadth is a ceiling, not a promise to spawn this many agents.
MULTI_AGENT_MODE=auto
MULTI_AGENT_MAX_AGENTS=11

# ---------------------------------------------------------------- project fleet
# Fleet workers manage many projects through the same Run/Task execution path.
# Increase only after measuring database/model pressure; the scheduler adapts
# concurrency downward when the system is saturated or erroring.
# Scale worker processes/hosts at the deployment layer; each process runs one
# lease-fenced fleet worker and can use stable partitioning below.
FLEET_MAX_CONCURRENCY=4
FLEET_BATCH_SIZE=8
# Optional stable sharding for multiple worker processes/hosts.
FLEET_PARTITIONS=1
FLEET_PARTITION=

# ---------------------------------------------------------------- tools
# Set false to stop the AI reading public web pages (it reads attached files
# and calculates either way).
TOOLS_WEB_ACCESS=true

# ---------------------------------------------------------------- usage & billing
# AI tokens each person may use in a rolling 4-hour window and a rolling week.
# 0 or empty: no limit. Usage is always recorded and shown in Settings → Usage.
# Topics this service does not discuss at all, comma-separated, or "none".
BLOCKED_TOPICS=religion

# Age and terms people confirm before their first chat (docs/USAGE_POLICY.md).
MINIMUM_AGE=16
TERMS_VERSION=2026-09
TERMS_REQUIRED=true

USAGE_LIMIT_4H_TOKENS=
USAGE_LIMIT_WEEKLY_TOKENS=
# How many tokens the model can read at once (for the chat context meter).
# Empty: the provider's usual size.
AI_CONTEXT_WINDOW_TOKENS=
# Shown in Settings → Billing. Card details and billing-profile data are never
# collected here; Stripe's hosted customer portal manages payment methods, invoices and billing details.
BILLING_PLAN_NAME=
BILLING_PORTAL_URL=
BILLING_SUPPORT_EMAIL=
# Email sign-in: people enter their email and get a one-time link (15 min).
# Links point at PUBLIC_URL, which production requires for email sign-in. The
# sending account (SMTP, e.g. your Gmail with an app password) is set by a
# platform administrator in Settings → Email sending; its password is stored
# encrypted with OBJECT_ENCRYPTION_KEY. Grant the right with
#   node bin/admin.js platform-admin --email you@example.com
# Anyone may create an account by signing in; set false to allow only
# existing accounts.
ALLOW_SIGNUP=true
# Stripe: set all four to sell plans. People pay on Stripe's pages; a plan
# becomes active only through the signed webhook at <PUBLIC_URL>/api/stripe/webhook
# (events: checkout.session.completed, customer.subscription.*).
# Each plan's limits replace the defaults above while it is active.
PUBLIC_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Paid plans, in the order shown after Free. A plan with contactUrl is sold by
# your team: create its subscription in Stripe with metadata plan_id=<id>.
# Example only — replace these values with your commercial pricing and measured
# token budget. All plans use the adaptively selected Vertex Gemini model.
# [{"id":"pro","name":"Pro","priceId":"price_…","price":"<your price>","fourHourTokens":60000,"weeklyTokens":200000},
#  {"id":"plus","name":"Plus","priceId":"price_…","price":"<your price>","fourHourTokens":120000,"weeklyTokens":500000},
#  {"id":"enterprise","name":"Enterprise","contactUrl":"mailto:sales@example.com","price":"Custom","features":["Single sign-on","Invoices"]}]
STRIPE_PLANS=
# The free plan: everyone without a subscription. Its limits are USAGE_LIMIT_* above.
BILLING_FREE_NAME=Free
BILLING_FREE_DESCRIPTION=
# Features, separated by |
BILLING_FREE_FEATURES=

# ---------------------------------------------------------------- execution
# Empty means "not configured". The API reports that explicitly rather than
# pretending the work ran.
# Kindgleam's own sealed sandbox for running code, installing libraries and
# building workspace tools (bin/sandbox-runner.js; see docs/SANDBOX_AND_TOOL_FORGE.md).
SANDBOX_RUNNER_URL=
# Set on the sandbox runner's host:
#   SANDBOX_DOCKER=docker             container CLI (podman works)
#   SANDBOX_RUNTIME=runsc             production: runsc (gVisor) or kata-runtime
#   SANDBOX_IMAGE_PYTHON=python:3.12-slim@sha256:<64-hex-digest>
#   SANDBOX_IMAGE_NODE=node:22-slim@sha256:<64-hex-digest>
#   SANDBOX_IMAGE_GO=golang:1.23-alpine@sha256:<64-hex-digest>
#   SANDBOX_IMAGE_JAVA=eclipse-temurin:21-jdk-alpine@sha256:<64-hex-digest>
#   SANDBOX_IMAGE_GCC=gcc:14@sha256:<64-hex-digest> (C and C++)
#   SANDBOX_IMAGE_RUST=rust:1-alpine@sha256:<64-hex-digest>
#   SANDBOX_LANGUAGES=               languages it runs, e.g. python,javascript,java (default all)
#   SANDBOX_PULL_ON_DEMAND=true      fetch a language's image the first time it is needed
#   SANDBOX_CA_FILE=                  CA for registries behind a TLS-inspecting proxy
#   SANDBOX_INSTALL_PROXY=            HTTPS proxy for the install phase only
# Sent to hosted runners as: Authorization: Bearer <token>
SANDBOX_RUNNER_TOKEN=
TOOL_RUNNER_TOKEN=
# Legacy RUNNER_TOKEN is development-only fallback; do not set it in production.
RUNNER_TOKEN=

# ---------------------------------------------------------------- adaptive execution
# Browser-to-local-agent origin. Leave empty to disable local execution.
# The local agent must enforce its own origin/pairing policy.
# In production, LOCAL_AGENT_ISOLATION must be container or vm.
LOCAL_AGENT_URL=http://127.0.0.1:8765
# Same 32+ character secret must be configured on the paired local agent.
# It is never sent to the browser; it authenticates local execution receipts.
LOCAL_AGENT_SHARED_SECRET=
# Deployment declaration for the isolation boundary: none | container | vm.
LOCAL_AGENT_ISOLATION=none
# A local agent is never contacted unless this URL is configured.

# ---------------------------------------------------------------- limits
MAX_REQUEST_BYTES=8388608
MAX_OBJECT_BYTES=5242880
MAX_RESPONSE_BYTES=4194304
WORKSPACE_MAX_BYTES=1073741824
WORKSPACE_MAX_OBJECTS=10000
RATE_WINDOW_MS=60000
# Production must use postgres for multi-instance request admission.
RATE_LIMIT_STORE=memory
RATE_MAX=300
# How many times a run may replan before it is declared exhausted.
MAX_RUN_ATTEMPTS=5
SESSION_HOURS=12

# Generic capability/research/tool router (optional; discovered capabilities stay pending without it).
# The built-in runner (npm run tool-runner) implements web.fetch, http.check and
# math.evaluate. Point this at it, e.g. http://127.0.0.1:8766 in development;
# production requires https (set TOOL_RUNNER_TLS_CERT/KEY on the runner).
TOOL_RUNNER_URL=
# Built-in tool runner process (uses the same RUNNER_TOKEN as above).
TOOL_RUNNER_HOST=127.0.0.1
TOOL_RUNNER_PORT=8766
TOOL_RUNNER_TLS_CERT=
TOOL_RUNNER_TLS_KEY=


# ---------------------------------------------------------------- local agent
# Run separately on the user's machine with: npm run local-agent
LOCAL_AGENT_HOST=127.0.0.1
LOCAL_AGENT_PORT=8765
# Must exactly match the Kindgleam web origin, e.g. http://localhost:3000
LOCAL_AGENT_ALLOWED_ORIGIN=
# When running the local agent, give it the same LOCAL_AGENT_SHARED_SECRET value.
# Disabled by default. Enable only after reviewing the local execution policy.
LOCAL_AGENT_ALLOW_PROCESS_EXECUTION=false
LOCAL_AGENT_RUN_ROOT=.kindgleam-local-workspace
LOCAL_AGENT_TIMEOUT_MS=120000
LOCAL_AGENT_MAX_OUTPUT_BYTES=4194304

# Separate backup encryption key: standard base64 encoding of exactly 32 random bytes.
# Backups are encrypted as they stream out of pg_dump; no plaintext dump is intentionally materialized.
BACKUP_ENCRYPTION_KEY=

MAX_GOAL_CHARS=32000
MAX_EVIDENCE_BYTES=524288
MAX_PROVENANCE_BYTES=65536
MAX_FIELD_CHARS=512

# Independent second review of verified work. A separate reviewer agent, on a
# different model where the plan allows one, looks for what the verifier missed
# and can only turn a pass into a fail.
#   auto   (default) only complex, high-stakes, code or retried work
#   always every verified run except crisis and declined requests
#   off    never (no extra tokens)
# It costs one extra model call per reviewed run, recorded in usage.
# AGENTS_REVIEW=auto

# ---------------------------------------------------------------- terminal
# Optional interactive terminal for the Code Workspace. It runs inside a
# disposable sandbox container and never exposes the host shell to the browser.
TERMINAL_ENABLED=true
# Development may use docker; production must use runsc or kata-runtime.
TERMINAL_RUNTIME=
TERMINAL_MAX_SESSIONS_PER_PRINCIPAL=2
TERMINAL_MAX_SESSIONS_PER_WORKSPACE=4
TERMINAL_IDLE_MS=600000
TERMINAL_LIFETIME_MS=1800000
TERMINAL_MAX_OUTPUT_BYTES=8388608
TERMINAL_MAX_INPUT_BYTES_PER_SECOND=131072
# Production: every image must be pinned with @sha256:<64-hex-digest>.
TERMINAL_IMAGES_JSON=
